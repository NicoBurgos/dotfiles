layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {

                format_left "{mode} #[fg=cyan,bold]{tabs}"
                format_center "#[fg=fg,bold]{session}"
                format_right "{command_git_branch} {datetime}"
                format_space ""

                border_enabled "false"
                border_char "─"
                border_format "#[fg=bright_black]{char}"
                border_position "top"

                mode_normal "#[bg=green,fg=bg,bold] NORMAL "
                mode_tmux "#[bg=yellow,fg=bg,bold] TMUX "

                tab_normal "#[fg=bright_black] {name} │ "
                tab_active "#[fg=bright_green,bold,italic] {name} │ "

                command_git_branch_command "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format "#[fg=green] {stdout}"
                command_git_branch_interval "10"
                command_git_branch_rendermode "static"

                datetime "#[fg=bright_black,bold] {format}"
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "America/Argentina/Jujuy"
            }
        }

        children

// Elimina el plugin "zellij:status-bar" y usa zjstatus:
pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                
                // Estructura de la barra
                format_left  "{mode}"
                format_center ""
                format_right "#[bg=black,fg=white] {session} "
                format_space "#[bg=black]" 
                
                // --- CONFIGURACIÓN DE MODOS CON HINTS INCORPORADOS ---
                // Cada modo cambia el color principal y muestra los atajos más útiles
                
                mode_locked "#[bg=red,fg=bg,bold] BLOQUEADO #[bg=black,fg=bright_white,bold] <Ctrl+g> #[bg=black,fg=white]Normal "
                
                mode_normal "#[bg=green,fg=bg,bold] NORMAL #[bg=black,fg=bright_white,bold] <p> #[bg=black,fg=white]Pane #[bg=black,fg=bright_white,bold] <t> #[bg=black,fg=white]Tab #[bg=black,fg=bright_white,bold] <r> #[bg=black,fg=white]Resize #[bg=black,fg=bright_white,bold] <s> #[bg=black,fg=white]Scroll #[bg=black,fg=bright_white,bold] <o> #[bg=black,fg=white]Session "
                
                mode_pane   "#[bg=blue,fg=bg,bold] PANE #[bg=black,fg=bright_white,bold] <h/j/k/l> #[bg=black,fg=white]Mover #[bg=black,fg=bright_white,bold] <n> #[bg=black,fg=white]Nuevo #[bg=black,fg=bright_white,bold] <x> #[bg=black,fg=white]Cerrar #[bg=black,fg=bright_white,bold] <f> #[bg=black,fg=white]Pantalla Completa "
                
                mode_tab    "#[bg=yellow,fg=bg,bold] TAB #[bg=black,fg=bright_white,bold] <h/l> #[bg=black,fg=white]Navegar #[bg=black,fg=bright_white,bold] <n> #[bg=black,fg=white]Nuevo #[bg=black,fg=bright_white,bold] <x> #[bg=black,fg=white]Cerrar #[bg=black,fg=bright_white,bold] <r> #[bg=black,fg=white]Renombrar "
                
                mode_resize "#[bg=magenta,fg=bg,bold] RESIZE #[bg=black,fg=bright_white,bold] <h/j/k/l> #[bg=black,fg=white]Ajustar tamaño #[bg=black,fg=bright_white,bold] <r> #[bg=black,fg=white]Normal "
                
                mode_scroll "#[bg=cyan,fg=bg,bold] SCROLL #[bg=black,fg=bright_white,bold] <h/j/k/l> #[bg=black,fg=white]Navegar #[bg=black,fg=bright_white,bold] <e> #[bg=black,fg=white]Editar #[bg=black,fg=bright_white,bold] <s> #[bg=black,fg=white]Normal "
                
                mode_session "#[bg=magenta,fg=bg,bold] SESSION #[bg=black,fg=bright_white,bold] <d> #[bg=black,fg=white]Desconectar #[bg=black,fg=bright_white,bold] <w> #[bg=black,fg=white]Gestor de Sesiones "
            }
        }
    }

    tab name="nvim" focus=true {
        pane
    }

    tab name="shell" {
        pane
    }
}
